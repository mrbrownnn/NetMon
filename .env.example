# Flask session secret
SECRET_KEY=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Local default sqlite:///netmon.db ; Railway: mount volume at /data
DATABASE_URL=sqlite:///netmon.db
# First admin created on empty DB
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 1 = seed demo devices/history once on an empty DB (demo only; unset before go-live)
NETMON_DEMO=0
# GNS3 2.2 server, e.g. http://127.0.0.1:3080 (local only). "demo" = built-in fake lab. Empty = off.
GNS3_URL=
